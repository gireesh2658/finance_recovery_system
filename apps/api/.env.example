AI_PROVIDER=OPENROUTER

# OpenRouter
OPENROUTER_API_KEY="sk-or-..."
OPENROUTER_MODEL="google/gemma-4-31b-it:free"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
AI_TIMEOUT_MS=30000
